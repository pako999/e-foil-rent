# Neon Postgres connection string (pooled URL recommended)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# MailerSend transactional email
# Get an API token at https://app.mailersend.com/domains/<your-domain>/api-tokens
MAILERSEND_API_TOKEN="mlsn.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MAILERSEND_FROM_EMAIL="bookings@surf-store.com"
MAILERSEND_FROM_NAME="Surf-Store E-Foil"
ENQUIRY_TO_EMAIL="info@surf-store.com"

# Admin gate (header `x-admin-token` or `admin_token` cookie)
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Public site URL (used by sitemap / canonical)
NEXT_PUBLIC_SITE_URL="https://efoil.surf-store.com"
